GITHUB_TOKEN=your_github_pat_here
OPENAI_API_KEY=your_openai_key_here
QDRANT_URL=http://localhost:6333
# Online LLM-as-judge: set to false to skip the evaluator pass entirely.
# Each Q&A or PR review otherwise costs one extra LLM call + one LangSmith feedback write.
EVAL_ENABLED=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=oss-contributor-agent # Optional, defaults to "default"
