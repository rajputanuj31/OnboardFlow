# Generated from apps/api/src/onboardflow/settings.py. Do not edit by hand:
#   make env-example

# local | test | staging | production
ENVIRONMENT=local

# Python logging level.
LOG_LEVEL=INFO

# Allowed browser origins, as a JSON list: ["https://app.example.com"]
CORS_ORIGINS=["http://localhost:3000"]

# --- database ---
# Async SQLAlchemy URL for Postgres, e.g. postgresql+asyncpg://user:password@localhost:5432/onboardflow
# (required)
DATABASE__URL=

# Connection pool size.
DATABASE__POOL_SIZE=5

# Timeout for opening a connection, in seconds.
DATABASE__CONNECT_TIMEOUT_S=3.0

# --- qdrant ---
# Qdrant server URL (server mode only; local paths are rejected).
QDRANT__URL=http://localhost:6333/

# Qdrant API key, if enabled.
QDRANT__API_KEY=

# Request timeout in seconds.
QDRANT__TIMEOUT_S=3.0

# --- github ---
# GitHub REST API base URL.
GITHUB__API_URL=https://api.github.com/

# Optional server token, used only for server-owned metadata lookups (higher rate limit). Never used to clone user-supplied repositories.
GITHUB__TOKEN=

# GitHub API request timeout.
GITHUB__TIMEOUT_S=10.0

# --- ingest ---
# Where snapshot checkouts are stored.
INGEST__DATA_DIR=.data/repos

# Hard timeout for git.
INGEST__CLONE_TIMEOUT_S=120.0

# Reject repos larger than this (GitHub-reported size).
INGEST__MAX_REPO_MB=200

# Reject snapshots with more files.
INGEST__MAX_FILES=20000

# Reject checkouts larger than this on disk.
INGEST__MAX_TOTAL_MB=500

# Larger files are kept for grep but not indexed.
INGEST__MAX_INDEXED_FILE_KB=1024

# --- worker ---
# Idle wait between job polls.
WORKER__POLL_INTERVAL_S=1.0

# A job whose lease expires is reclaimed by any worker.
WORKER__LEASE_S=60.0

# Attempts before a job fails.
WORKER__MAX_ATTEMPTS=3

# Base retry delay (doubles).
WORKER__RETRY_BACKOFF_S=5.0
